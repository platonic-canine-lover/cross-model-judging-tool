# Only the providers you use need their variables; a missing one fails at construction, naming the variable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Azure OpenAI (the models behind Copilot): target is azure:<deployment-name>
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Ollama, local; default is http://localhost:11434. For a Mac mini on the LAN:
OLLAMA_HOST=http://mac-mini.local:11434
# Copilot Studio agent (see docs/copilot-studio.md)
COPILOTSTUDIOAGENT__ENVIRONMENTID=
COPILOTSTUDIOAGENT__AGENTAPPID=
COPILOTSTUDIOAGENT__TENANTID=
